CONFIG_FILE = os.path.join(HOME, '.config', 'clip-hist', 'config.json')
DEFAULT_FONT = 11.0          # pt，接近系统正文 13.5pt 略小一档
FONT_MIN, FONT_MAX = 8.0, 20.0


_CONFIG_CACHE = None


def load_config(force=False):
    """读取配置。

    默认走内存缓存 —— 列表渲染时每行都会调用 get_show_thumbs()，
    再叠加每次 push 都要用的 get_max_items()，不缓存的话就是每行/每次复制都开一次文件。
    force=True 用于 CLI 改完配置后让守护进程重新读盘。
    """
    global _CONFIG_CACHE
    if _CONFIG_CACHE is not None and not force:
        return dict(_CONFIG_CACHE)
    try:
        with open(CONFIG_FILE, 'r', encoding='utf-8') as f:
            c = json.load(f)
        _CONFIG_CACHE = c if isinstance(c, dict) else {}
    except Exception:
        _CONFIG_CACHE = {}
    return dict(_CONFIG_CACHE)


def save_config(c):
    global _CONFIG_CACHE
    _CONFIG_CACHE = dict(c)
    os.makedirs(os.path.dirname(CONFIG_FILE), mode=0o700, exist_ok=True)
    tmp = CONFIG_FILE + '.tmp'
    try:
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(c, f, ensure_ascii=False, indent=2)
        os.replace(tmp, CONFIG_FILE)
    except Exception:
        pass


def get_num(key, default, lo, hi):
    try:
        v = float(load_config().get(key, default))
    except Exception:
        return float(default)
    return max(lo, min(hi, v))


def get_font_size():
    return get_num('font_size', DEFAULT_FONT, FONT_MIN, FONT_MAX)


def get_max_items():
    return int(get_num('max_items', MAX_ITEMS, 50, 5000))


def get_opacity():
    return get_num('opacity', 1.0, 0.5, 1.0)


def get_show_thumbs():
    """是否在列表里画缩略图。

    默认关闭：部分环境的 GDK 走 MIT-SHM 传位图会报 BadValue 并直接把进程打崩
    （本机实测 ShmPutImage 必崩），关掉后列表只显示 [图片 W×H] 文字，稳定优先。
    环境正常的话可以在设置里打开。
    """
    return bool(load_config().get('show_thumbs', False))


def get_argb():
    """是否启用 ARGB 视觉（圆角 + 半透明背景）。

    默认关闭。ARGB 窗口是 32 位视觉，GTK 每次重绘都要把整窗位图经 MIT-SHM
    上传给 X server；本环境这条路是坏的（ShmPutImage → BadValue → 进程崩），
    而输入框光标闪烁每秒都在触发重绘，所以崩溃只是时间问题。
    关掉后是普通 24 位不透明窗口：没有圆角，但稳定。
    """
    return bool(load_config().get('argb', False))


