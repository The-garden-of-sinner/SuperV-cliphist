class ClipHist(object):
    def __init__(self):
        _fix_perms()
        self.store = Store(HISTORY_FILE)
        self._own_hash = None       # 自己刚写进剪贴板的内容指纹
        self._own_timer = None      # 指纹的兜底清除定时器
        self._cap_timer = None      # owner-change 防抖
        self._clip_keeps = []       # 多格式写入的回调与数据（防 GC，按次保留）
        self.settings = None
        self.panel = ClipPanel(self)
        self.settings = SettingsDialog(self)

        self.clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        self.clipboard.connect('owner-change', self._on_owner_change)

        self.hotkey = HotkeyMonitor(self.panel.toggle)
        self.hotkey.start()

        self._start_ipc()

    # ---- 剪贴板监听 ----

    @staticmethod
    def _fingerprint(item):
        """条目指纹，用于识别「这次剪贴板变化是不是自己写进去的」。"""
        k = item.get('k', 'text')
        if k == 'image':
            return ('image', item.get('p', ''))
        if k == 'html':
            return ('html', hash(item.get('h', '')))
        if k == 'file':
            return ('file', item.get('v', ''))
        return ('text', item.get('v', ''))

    def _clear_own_hash(self):
        self._own_timer = None
        self._own_hash = None
        return False

    def _accept(self, item):
        """入库前先排除自己写入造成的 owner-change，其余照常记录。"""
        fp = self._fingerprint(item)
        if self._own_hash is not None and fp == self._own_hash:
            self._own_hash = None
            return False
        return self.store.push_item(item)

    def _on_owner_change(self, cb, event):
        # 富文本与截图会连续触发多次 owner-change，这里做 80ms 防抖，
        # 避免重复拉取剪贴板数据。
        if self._cap_timer:
            return          # 已经排队了，直接等这次捕获（读到的就是最新内容）
        self._cap_timer = GLib.timeout_add(80, self._capture)

    def _capture(self):
        self._cap_timer = None
        try:
            ok, targets = self.clipboard.wait_for_targets()
        except Exception:
            ok, targets = False, None
        if not ok or not targets:
            return False
        names = set(a.name() for a in targets)

        # 0) 文件复制：优先按路径记录。
        # 文件管理器复制文件时会同时提供 text/uri-list，图片文件还常附带
        # 一个缩略图；如果先走图片分支，存下来的就成了缩略图，路径反而丢了。
        if 'text/uri-list' in names:
            try:
                data = self.clipboard.wait_for_contents(
                    Gdk.Atom.intern('text/uri-list', False))
            except Exception:
                data = None
            if data is not None:
                raw = data.get_data()
                paths = uris_to_paths(raw.decode('utf-8', 'ignore')
                                      if raw else '')
                if paths:
                    self._accept({'k': 'file', 'v': '\n'.join(paths)})
                    return False

        # 1) 图片优先（网页/截图/图片编辑器）
        if names & IMAGE_TARGETS:
            try:
                pb = self.clipboard.wait_for_image()
            except Exception:
                pb = None
            # 某些应用（文件管理器）会附带一个 1×1 占位图，尺寸过小直接忽略
            if pb is not None and pb.get_width() > 2 and pb.get_height() > 2:
                self._push_image(pb)
                return False

        # 2) 富文本：同时保留 HTML 和纯文本回退
        if 'text/html' in names:
            try:
                data = self.clipboard.wait_for_contents(
                    Gdk.Atom.intern('text/html', False))
            except Exception:
                data = None
            if data is not None:
                raw = data.get_data()
                if raw:
                    doc = raw.decode('utf-8', 'ignore')
                    if doc.strip():
                        plain = ''
                        try:
                            plain = self.clipboard.wait_for_text() or ''
                        except Exception:
                            pass
                        self._accept({
                            'k': 'html',
                            'v': plain or strip_html(doc),
                            'h': doc})
                        return False

        # 3) 纯文本
        try:
            text = self.clipboard.wait_for_text()
        except Exception:
            text = None
        if text:
            self._accept({'k': 'text', 'v': text})
        return False

    def _push_image(self, pb):
        """图片落盘（按内容 md5 命名，天然去重）+ 生成缩略图。"""
        w, h = pb.get_width(), pb.get_height()
        if w < 3 or h < 3 or w > MAX_IMG_SIDE or h > MAX_IMG_SIDE:
            return
        try:
            ok, buf = pb.save_to_bufferv('png', [], [])
        except Exception:
            return
        if not ok or not buf or len(buf) > MAX_IMG_BYTES:
            return
        name = 'img_%s.png' % hashlib.md5(buf).hexdigest()[:16]
        os.makedirs(IMG_DIR, mode=0o700, exist_ok=True)
        path = os.path.join(IMG_DIR, name)
        if not os.path.exists(path):
            try:
                with open(path, 'wb') as f:
                    f.write(buf)
            except Exception:
                return

        thumb = 'th_' + name
        tpath = os.path.join(IMG_DIR, thumb)
        if not os.path.exists(tpath):
            try:
                w, h = pb.get_width(), pb.get_height()
                scale = float(THUMB_H) / max(1, h)
                tw, th = max(1, int(w * scale)), THUMB_H
                if tw > 260:
                    scale = 260.0 / w
                    tw, th = 260, max(1, int(h * scale))
                small = pb.scale_simple(tw, th, GdkPixbuf.InterpType.BILINEAR)
                if small is None or not small.savev(tpath, 'png', [], []):
                    thumb = name
            except Exception:
                thumb = name

        self._accept({
            'k': 'image',
            'v': '[图片 %d×%d]' % (pb.get_width(), pb.get_height()),
            'p': 'images/' + name,
            't': 'images/' + thumb,
            'w': pb.get_width(),
            'h': pb.get_height()})

    def set_clipboard(self, item):
        """把条目内容写回剪贴板。返回是否成功，失败时不应当再发 Ctrl+V。"""
        if not isinstance(item, dict):
            item = {'k': 'text', 'v': item or ''}
        kind = item.get('k', 'text')
        ok = True
        wrote_native = False     # 是否真的写入了多格式（而不是降级成纯文本）
        written_text = item.get('v', '') or ''
        try:
            if kind == 'image':
                path = os.path.join(DATA_DIR, item.get('p', ''))
                pb = GdkPixbuf.Pixbuf.new_from_file(path)
                if pb is None:
                    ok = False
                else:
                    self.clipboard.set_image(pb)
            elif kind == 'html' and item.get('h'):
                written_text = item.get('v') or strip_html(item['h'])
                wrote_native = self._set_html(item['h'], written_text)
            elif kind == 'file':
                paths = [p for p in (item.get('v') or '').splitlines() if p]
                if not paths:
                    ok = False
                else:
                    wrote_native = self._set_files(paths)
            else:
                self.clipboard.set_text(written_text, -1)
        except Exception:
            ok = False

        if ok:
            self.store.touch(item)
            # 指纹必须按「实际写进剪贴板的形式」算：
            # 多格式写入失败降级成纯文本时，若仍按原类型算，
            # 随后捕获到的那段纯文本会被当成新内容再入库一次。
            if kind in ('html', 'file') and not wrote_native:
                self._own_hash = ('text', written_text)
            else:
                self._own_hash = self._fingerprint(item)
            if self._own_timer:
                GLib.source_remove(self._own_timer)
            self._own_timer = GLib.timeout_add(2500, self._clear_own_hash)
        return ok

    def _set_multi(self, payloads):
        """一次写入多种剪贴板格式。payloads 为 [(target, bytes), ...]。

        返回实际写入的首选格式名；接口不可用或调用失败时返回 None。
        调用方必须能接受降级——这里只负责试，不负责兜底。
        """
        api = gtk_clipboard_api()
        if api is None:
            return None
        gtk, gdk, ptr = api
        try:
            entries = (_GtkTargetEntry * len(payloads))(*[
                _GtkTargetEntry(t.encode('ascii'), 0, i)
                for i, (t, _b) in enumerate(payloads)])
            names = [t for t, _b in payloads]
            blobs = [b for _t, b in payloads]

            def on_get(_c, sel, info, _d):
                if info >= len(blobs):
                    return
                atom = gdk.gdk_atom_intern(names[info].encode('ascii'), 0)
                data = blobs[info]
                gtk.gtk_selection_data_set(sel, atom, 8, data, len(data))

            # 回调与数据必须一直持有：一旦被 GC，GTK 下次来取就是野指针。
            # 用**列表**而不是单个引用：写入新内容时 GTK 会先对旧数据调用
            # clear，如果 clear 里把当前引用置空，新写入的那份就被连带丢掉，
            # 之后任何应用来取数据都会踩空。
            keep = [entries, blobs, None, None]

            def on_clear(_c, _d):
                try:
                    self._clip_keeps.remove(keep)
                except ValueError:
                    pass

            get_cb = _CLIP_GET_FUNC(on_get)
            clear_cb = _CLIP_CLEAR_FUNC(on_clear)
            keep[2], keep[3] = get_cb, clear_cb
            self._clip_keeps.append(keep)
            gtk.gtk_clipboard_set_with_data(ptr, entries, len(payloads),
                                            get_cb, clear_cb, None)
            return names[0]
        except Exception:
            return None

    def _set_html(self, doc, plain):
        """写入 text/html + 纯文本。返回 True 表示 HTML 真的写进去了。"""
        plain = plain or strip_html(doc)
        got = self._set_multi([
            ('text/html', doc.encode('utf-8')),
            ('UTF8_STRING', plain.encode('utf-8')),
            ('text/plain;charset=utf-8', plain.encode('utf-8')),
            ('text/plain', plain.encode('utf-8')),
        ])
        if got:
            return True
        self.clipboard.set_text(plain, -1)
        return False

    def _set_files(self, paths):
        """写入 text/uri-list，让文件管理器能真正粘贴出文件。"""
        paths = [p for p in paths if p]
        if not paths:
            return False
        text = '\n'.join(paths)
        uris = ['file://' + urllib.parse.quote(p) for p in paths]
        uri_blob = ('\r\n'.join(uris) + '\r\n').encode('utf-8')
        # GNOME/Nautilus 系还认这个私有格式，一并给上
        gnome = ('copy\n' + '\n'.join(uris)).encode('utf-8')
        got = self._set_multi([
            ('text/uri-list', uri_blob),
            ('x-special/gnome-copied-files', gnome),
            ('UTF8_STRING', text.encode('utf-8')),
            ('text/plain;charset=utf-8', text.encode('utf-8')),
            ('text/plain', text.encode('utf-8')),
        ])
        if got:
            return True
        self.clipboard.set_text(text, -1)
        return False

    def _on_ipc_clear(self):
        """IPC 来的清空请求：必须回主线程执行，否则与 GTK 线程的 push 撞车。"""
        if self.store.clear():
            if self.panel.is_visible():
                self.panel._rebuild()
        else:
            self.panel._notify('清空失败：历史文件无法写入')
        return False

    def open_settings(self):
        if self.panel.is_visible():
            self.panel.hide()
        if self.settings is not None:
            self.settings.show()
        return False

    # ---- IPC ----

    def _start_ipc(self):
        os.makedirs(os.path.dirname(SOCK_FILE), exist_ok=True)
        try:
            if os.path.exists(SOCK_FILE):
                os.unlink(SOCK_FILE)
        except Exception:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCK_FILE)
        try:
            os.chmod(SOCK_FILE, 0o600)
        except Exception:
            pass
        srv.listen(5)
        self.srv = srv

        def loop():
            while True:
                try:
                    conn, _ = srv.accept()
                except Exception:
                    return
                try:
                    data = conn.recv(64).decode('utf-8', 'ignore').strip()
                    if data == 'show':
                        GLib.idle_add(self.panel.show)
                    elif data == 'toggle':
                        GLib.idle_add(self.panel.toggle)
                    elif data == 'quit':
                        GLib.idle_add(Gtk.main_quit)
                    elif data == 'clear':
                        GLib.idle_add(self._on_ipc_clear)
                    elif data == 'reload':
                        GLib.idle_add(self.panel.reload_css)
                    elif data == 'settings':
                        GLib.idle_add(self.open_settings)
                    elif data == 'ping':
                        pass
                except Exception:
                    pass
                finally:
                    conn.close()

        threading.Thread(target=loop, daemon=True).start()

    def _snapshot_tick(self):
        try:
            if hasattr(self.store, '_maybe_snapshot'):
                self.store._maybe_snapshot()
        except Exception:
            pass
        return True

    def run(self):
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, Gtk.main_quit)
        # 每小时检查一次快照是否到期：只靠启动时检查的话，
        # 长期不重启的守护进程永远不会有第二份快照
        GLib.timeout_add_seconds(3600, self._snapshot_tick)
        GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, Gtk.main_quit)
        Gtk.main()
        try:
            os.unlink(SOCK_FILE)
        except Exception:
            pass


