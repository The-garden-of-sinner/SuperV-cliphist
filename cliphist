class _GtkTargetEntry(ctypes.Structure):
    _fields_ = [('target', ctypes.c_char_p),
                ('flags', ctypes.c_uint),
                ('info', ctypes.c_uint)]


_CLIP_GET_FUNC = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p,
                                  ctypes.c_uint, ctypes.c_void_p)
_CLIP_CLEAR_FUNC = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_void_p)
_CLIP_API = None


def gtk_clipboard_api():
    """惰性准备 ctypes 版的多格式剪贴板接口；不可用时返回 None。

    为什么不用 PyGObject：3.36 的 Gtk.Clipboard 只绑定了 set_text / set_image。
    写入 text/html、text/uri-list 需要 gtk_clipboard_set_with_data，
    它接收 C 函数指针，GI 无法自动转换；而 Gtk.Clipboard.__gpointer__
    是个 NULL PyCapsule，也拿不到对象地址。
    所以从 C 侧用 gtk_clipboard_get(CLIPBOARD) 取同一个单例指针。
    """
    global _CLIP_API
    if _CLIP_API is not None:
        return _CLIP_API or None
    try:
        gtk = ctypes.CDLL('libgtk-3.so.0')
        gdk = ctypes.CDLL('libgdk-3.so.0')

        gdk.gdk_atom_intern.restype = ctypes.c_void_p
        gdk.gdk_atom_intern.argtypes = [ctypes.c_char_p, ctypes.c_int]

        gtk.gtk_clipboard_get.restype = ctypes.c_void_p
        gtk.gtk_clipboard_get.argtypes = [ctypes.c_void_p]

        gtk.gtk_clipboard_set_with_data.restype = None
        gtk.gtk_clipboard_set_with_data.argtypes = [
            ctypes.c_void_p, ctypes.POINTER(_GtkTargetEntry), ctypes.c_uint,
            _CLIP_GET_FUNC, _CLIP_CLEAR_FUNC, ctypes.c_void_p]

        gtk.gtk_selection_data_set.restype = ctypes.c_int
        gtk.gtk_selection_data_set.argtypes = [
            ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int,
            ctypes.c_char_p, ctypes.c_int]

        ptr = gtk.gtk_clipboard_get(gdk.gdk_atom_intern(b'CLIPBOARD', 0))
        if not ptr:
            raise RuntimeError('gtk_clipboard_get 返回空')
        _CLIP_API = (gtk, gdk, ptr)
    except Exception:
        _CLIP_API = False        # 记下失败，避免每次重试
    return _CLIP_API or None

