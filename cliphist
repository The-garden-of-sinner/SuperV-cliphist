def _try_lock():
    """拿单实例锁。成功返回文件对象（调用方需一直持有到进程退出），失败返回 None。

    以 O_RDWR 打开而不是 'w'：'w' 会在拿锁之前就把文件截断，
    等于把正在运行实例写进去的 PID 清掉；截断必须发生在拿到锁之后。
    """
    f = None
    try:
        fd = os.open(LOCK_FILE, os.O_RDWR | os.O_CREAT, 0o600)
        f = os.fdopen(fd, 'r+')
        fcntl.flock(f.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        f.seek(0)
        f.truncate()
        f.write(str(os.getpid()))
        f.flush()
        return f
    except Exception:
        if f is not None:
            try:
                f.close()
            except Exception:
                pass
        return None


def _socket_alive():
    """socket 是否真的能连上（存在文件不等于服务在跑）。"""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.3)
        s.connect(SOCK_FILE)
        s.sendall(b'ping')
        s.close()
        return True
    except Exception:
        return False

