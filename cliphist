# X11 全局热键（ctypes 直接调用 libX11，无需 python-xlib）
# --------------------------------------------------------------------------

class _XEvent(ctypes.Union):
    _fields_ = [('type', ctypes.c_int), ('pad', ctypes.c_long * 24)]


MOD_SUPER = 64                     # Mod4Mask
LOCK_VARIANTS = (0, 2, 16, 18)     # 无锁定 / CapsLock / NumLock / 两者
KEY_PRESS = 2


class HotkeyMonitor(threading.Thread):
    """在独立 X 连接上抓取 Super+V，触发时回调。"""

    daemon = True

    def __init__(self, callback):
        super().__init__(name='hotkey')
        self.callback = callback
        self.started_ok = False
        self._last = 0.0

    def run(self):
        try:
            x11 = ctypes.CDLL('libX11.so.6')
        except OSError:
            return

        x11.XOpenDisplay.restype = ctypes.c_void_p
        x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x11.XDefaultRootWindow.restype = ctypes.c_ulong
        x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        x11.XStringToKeysym.restype = ctypes.c_ulong
        x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
        x11.XKeysymToKeycode.restype = ctypes.c_ubyte
        x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        x11.XGrabKey.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint,
                                 ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_int]
        x11.XSelectInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_long]
        x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]

        dpy = x11.XOpenDisplay(None)
        if not dpy:
            return
        self._x11 = x11

        # 抓取失败（已被别的客户端占用）时 Xlib 会抛 BadAccess，必须捕获并计数，
        # 否则进程静默活着却不响应热键，排查起来极其费劲。
        errs = []
        CB = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)

        def _on_x_error(_d, _e):
            errs.append(1)
            return 0

        self._err_cb = CB(_on_x_error)      # 必须持有引用，否则回调被 GC 回收
        x11.XSetErrorHandler.argtypes = [CB]
        x11.XSetErrorHandler.restype = ctypes.c_void_p
        prev_handler = x11.XSetErrorHandler(self._err_cb)

        root = x11.XDefaultRootWindow(dpy)
        keycode = x11.XKeysymToKeycode(dpy, x11.XStringToKeysym(b'v'))

        def _grab_once():
            del errs[:]
            for extra in LOCK_VARIANTS:
                x11.XGrabKey(dpy, keycode, MOD_SUPER | extra, root, 1, 1, 1)
            x11.XSelectInput(dpy, root, 1)  # KeyPressMask
            x11.XSync(dpy, 0)
            return len(errs)

        # 崩溃重启时，上一个进程的 grab 可能还没被 X 服务端完全释放，
        # 第一次抓取会 4/4 失败。那时进程照旧"运行中"，但热键是死的——
        # 所以这里重试几秒，而不是抓到什么算什么。
        conflicts = _grab_once()
        for _ in range(10):
            if conflicts == 0:
                break
            time.sleep(0.3)
            conflicts = _grab_once()

        if conflicts:
            # 三次都失败，多半是上次崩溃留下的孤儿实例还占着键。
            # 此刻本进程尚未创建任何窗口，断开别人不会误伤自己。
            killed = kill_stale_clients()
            if killed:
                sys.stderr.write('[cliphist] 已断开 %d 个残留实例，重试抓键\n'
                                 % killed)
                sys.stderr.flush()
                time.sleep(0.4)
                conflicts = _grab_once()

        # 抓完立刻把原来的 handler 还回去。X 的 error handler 是进程级的，
        # 一直挂着会把 GDK 的 X 错误也一并吞掉，后续排查会更困难。
        if prev_handler:
            try:
                x11.XSetErrorHandler(ctypes.cast(prev_handler, CB))
            except Exception:
                pass

        self.grab_conflicts = conflicts
        if self.grab_conflicts:
            sys.stderr.write(
                '[cliphist] 警告：Super+V 已被其他实例占用（%d/4 个组合抓取失败），'
                '本进程将收不到热键。请先运行 cliphist stop 再启动。\n'
                % self.grab_conflicts)
            sys.stderr.flush()
        self.started_ok = True

        ev = _XEvent()
        while True:
            x11.XNextEvent(dpy, ctypes.byref(ev))
            if ev.type == KEY_PRESS:
                now = time.monotonic()
                if now - self._last < HOTKEY_DELAY_MS / 1000.0:
                    continue
                self._last = now
                GLib.idle_add(self.callback)


