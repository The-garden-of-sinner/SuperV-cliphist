def _unique_backup(path, suffix):
    """给 path 生成一个不覆盖已有文件的备份名，并改名过去。返回新路径或 None。"""
    try:
        stamp = time.strftime('%Y%m%d-%H%M%S')
        bak = '%s.%s-%s' % (path, suffix, stamp)
        n = 1
        while os.path.exists(bak):
            bak = '%s.%s-%s-%d' % (path, suffix, stamp, n)
            n += 1
        os.replace(path, bak)
        return bak
    except Exception:
        return None


class SqliteStore(object):
    """SQLite 存储。

    对外接口与 JsonStore 完全一致（items / push_item / touch / remove /
    clear / _trim / save / _purge_files），差别只在写入方式：
    JSON 每次全量重写整份历史，条目越长写放越大；sqlite 只写变化的那几页。

    内存里仍保留一份列表供面板搜索与渲染，条目多带一个 _id 指向数据库行。
    _id 不会写进快照，快照就是一份可以直接读的 JSON。
    """

    def __init__(self, path, legacy_json=None):
        self.path = path                 # history.db
        self.legacy_json = legacy_json   # 旧 history.json，迁移成功后改名留档
        self.items = []
        self.readonly = False
        self.dirty = False
        self._seq = 0
        self._uid = 0
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        self.conn = None
        try:
            self.conn = self._connect()
            self._prepare()
        except sqlite3.DatabaseError as e:
            # 连 PRAGMA 都执行不了：文件损坏或根本不是数据库。
            # 先留档，再重建，最后尽量用快照把数据捞回来。
            self._quarantine_db(e)
            self.conn = self._connect()
            self._create_schema()
            self._restore_latest_snapshot()
            self.load()
        except Exception:
            try:
                if self.conn is not None:
                    self.conn.close()
            except Exception:
                pass
            raise

    # ---- 连接与建表 ----

    def _connect(self):
        conn = sqlite3.connect(self.path)
        conn.execute('PRAGMA journal_mode=WAL')
        conn.execute('PRAGMA synchronous=NORMAL')
        conn.execute('PRAGMA busy_timeout=3000')
        for suffix in ('', '-wal', '-shm'):
            try:
                os.chmod(self.path + suffix, 0o600)
            except Exception:
                pass
        return conn

    def _prepare(self):
        try:
            verdict = self.conn.execute('PRAGMA integrity_check').fetchone()[0]
        except Exception as e:
            verdict = 'error: %s' % e
        if verdict != 'ok':
            # 库自身坏了：改名留档，尝试用最近一份快照重建
            self._quarantine_db(verdict)
            self.conn = self._connect()
            self._create_schema()
            self._restore_latest_snapshot()
            self.load()
            return

        self._create_schema()
        self._migrate_from_json()
        self.load()
        self._maybe_snapshot()

    def _quarantine_db(self, reason):
        """把损坏的库连同 WAL 一起改名留档，绝不直接删。

        WAL 里可能还有尚未 checkpoint 的已提交事务，删掉就等于丢数据；
        但也不能留在原路径——新库建起来后 SQLite 会尝试套用旧 WAL。
        所以整体搬到备份名旁边，供 `sqlite3 .recover` 之类的工具抢救。
        """
        try:
            if self.conn is not None:
                self.conn.close()
        except Exception:
            pass
        bak = _unique_backup(self.path, 'corrupt')
        for suffix in ('-wal', '-shm'):
            src = self.path + suffix
            if not os.path.exists(src):
                continue
            try:
                os.replace(src, bak + suffix)
            except Exception:
                pass
        sys.stderr.write('[cliphist] 历史库损坏（%s），已另存为 %s（含 WAL）\n'
                         % (reason, bak))
        sys.stderr.flush()
        return bak

    def _create_schema(self):
        self.conn.execute('''CREATE TABLE IF NOT EXISTS items(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ukey TEXT NOT NULL,
            k TEXT NOT NULL,
            v TEXT,
            htext TEXT,
            p TEXT,
            tpath TEXT,
            w INTEGER,
            ih INTEGER,
            ts REAL NOT NULL,
            seq INTEGER NOT NULL)''')
        self.conn.execute('CREATE INDEX IF NOT EXISTS idx_items_ukey ON items(ukey)')
        self.conn.execute('CREATE INDEX IF NOT EXISTS idx_items_seq ON items(seq)')
        self.conn.commit()

    # ---- 迁移与快照 ----

    @staticmethod
    def _ukey(it):
        k = it.get('k', 'text')
        if k == 'image':
            raw = it.get('p', '')
        elif k == 'html':
            raw = it.get('h', '')
        else:
            raw = it.get('v', '')
        return k + ':' + hashlib.md5(
            (raw or '').encode('utf-8', 'ignore')).hexdigest()

    def _migrate_from_json(self):
        try:
            if self.conn.execute('SELECT COUNT(*) FROM items').fetchone()[0]:
                return
        except Exception:
            return
        src = self.legacy_json
        if not src or not os.path.isfile(src):
            return
        try:
            with open(src, 'r', encoding='utf-8') as f:
                data = json.load(f)
            if not isinstance(data, list):
                raise ValueError('root is not a list')
        except (ValueError, UnicodeDecodeError) as e:
            # 内容坏了：改名留档，绝不静默丢弃
            bak = _unique_backup(src, 'corrupt')
            sys.stderr.write('[cliphist] 旧历史无法解析（%s），已另存为 %s\n'
                             % (e, bak))
            sys.stderr.flush()
            return
        except OSError as e:
            # 读不动（权限/占用）：什么都不动，下次再迁
            sys.stderr.write('[cliphist] 旧历史读取失败（%s），本次不迁移\n' % e)
            sys.stderr.flush()
            return

        rows = [x for x in data
                if isinstance(x, dict) and ('v' in x or 'h' in x)]
        seq = 0
        for it in reversed(rows):        # 旧列表是「新→旧」，反着插才是正序
            seq += 1
            k = it.get('k', 'text')
            try:
                self.conn.execute(
                    'INSERT INTO items(ukey,k,v,htext,p,tpath,w,ih,ts,seq)'
                    ' VALUES(?,?,?,?,?,?,?,?,?,?)',
                    (self._ukey(it), k, it.get('v', ''),
                     it.get('h') if k == 'html' else None,
                     it.get('p'), it.get('t'),
                     it.get('w') if k == 'image' else None,
                     it.get('h') if k == 'image' else None,
                     float(it.get('ts') or time.time()), seq))
            except Exception:
                continue
        self.conn.commit()
        self._seq = seq

        # 迁移完成：旧文件改名留档，而不是删除
        try:
            os.replace(src, src + '.migrated')
        except Exception:
            pass
        sys.stderr.write('[cliphist] 已迁移 %d 条历史到 sqlite，'
                         '原文件保留为 history.json.migrated\n' % seq)
        sys.stderr.flush()

    def _maybe_snapshot(self):
        try:
            os.makedirs(SNAPSHOT_DIR, mode=0o700, exist_ok=True)
            names = sorted(n for n in os.listdir(SNAPSHOT_DIR)
                           if n.endswith('.json'))
            newest = 0.0
            if names:
                newest = os.path.getmtime(os.path.join(SNAPSHOT_DIR, names[-1]))
            if time.time() - newest < SNAPSHOT_INTERVAL:
                return
            path = os.path.join(SNAPSHOT_DIR,
                                'history-%s.json' % time.strftime('%Y%m%d-%H%M'))
            if not os.path.exists(path):
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, 'w', encoding='utf-8') as f:
                    json.dump([{k: v for k, v in it.items() if k != '_id'}
                               for it in self.items], f, ensure_ascii=False)
            names = sorted(n for n in os.listdir(SNAPSHOT_DIR)
                           if n.endswith('.json'))
            for old in names[:-SNAPSHOT_KEEP]:
                try:
                    os.unlink(os.path.join(SNAPSHOT_DIR, old))
                except Exception:
                    pass
        except Exception as e:
            sys.stderr.write('[cliphist] 快照失败：%s\n' % e)
            sys.stderr.flush()

    def _restore_latest_snapshot(self):
        """库损坏后，用最近一份快照把数据捞回来。返回是否恢复成功。"""
        try:
            names = sorted(n for n in os.listdir(SNAPSHOT_DIR)
                           if n.endswith('.json'))
        except Exception:
            return False
        for name in reversed(names):
            # 每份快照一个 SAVEPOINT：中途失败就整体回滚，
            # 否则半截记录会留在这个事务里，被下一份快照的 commit 一起提交，
            # 结果两代数据混在一起。
            self.conn.execute('SAVEPOINT snap')
            try:
                with open(os.path.join(SNAPSHOT_DIR, name),
                          'r', encoding='utf-8') as f:
                    data = json.load(f)
                if not isinstance(data, list):
                    raise ValueError('快照根不是数组')
                seq = 0
                for it in reversed(data):
                    if not isinstance(it, dict):
                        continue
                    seq += 1
                    k = it.get('k', 'text')
                    self.conn.execute(
                        'INSERT INTO items(ukey,k,v,htext,p,tpath,w,ih,ts,seq)'
                        ' VALUES(?,?,?,?,?,?,?,?,?,?)',
                        (self._ukey(it), k, it.get('v', ''),
                         it.get('h') if k == 'html' else None,
                         it.get('p'), it.get('t'),
                         it.get('w') if k == 'image' else None,
                         it.get('h') if k == 'image' else None,
                         float(it.get('ts') or time.time()), seq))
                self.conn.execute('RELEASE snap')
                self.conn.commit()
                self._seq = seq
                sys.stderr.write('[cliphist] 已从快照 %s 恢复 %d 条\n'
                                 % (name, seq))
                sys.stderr.flush()
                return True
            except Exception as e:
                try:
                    self.conn.execute('ROLLBACK TO snap')
                    self.conn.execute('RELEASE snap')
                except Exception:
                    pass
                sys.stderr.write('[cliphist] 快照 %s 恢复失败（%s），尝试更早一份\n'
                                 % (name, e))
                sys.stderr.flush()
                continue
        return False

    # ---- 读写 ----

    def load(self):
        if self.dirty:
            sys.stderr.write('[cliphist] 存在未保存的改动，跳过重新读取历史库\n')
            sys.stderr.flush()
            return
        rows = self.conn.execute(
            'SELECT id,k,v,htext,p,tpath,w,ih,ts,seq FROM items'
            ' ORDER BY seq DESC').fetchall()
        self.items = []
        for r in rows:
            _id, k, v, htext, p, tpath, w, ih, ts, seq = r
            it = {'_id': _id, 'k': k or 'text', 'v': v or '',
                  'ts': ts or time.time()}
            if k == 'html':
                if htext:
                    it['h'] = htext
            elif k == 'image':
                if p:
                    it['p'] = p
                if tpath:
                    it['t'] = tpath
                if w is not None:
                    it['w'] = w
                if ih is not None:
                    it['h'] = ih
            self.items.append(it)
        self._seq = max([0] + [r[9] for r in rows])
        self.readonly = False

    def save(self):
        if self.readonly:
            self.dirty = True
            return False
        try:
            self.conn.commit()
            self.dirty = False
            return True
        except Exception as e:
            sys.stderr.write('[cliphist] 历史保存失败：%s\n' % e)
            sys.stderr.flush()
            # 必须回滚：否则未提交的 DELETE/INSERT 会留在事务里，
            # 下一次 commit 时被一并执行，内存与磁盘就对不上了
            try:
                self.conn.rollback()
            except Exception:
                pass
            self.dirty = True
            self.readonly = True     # 再写也是失败，先停手，避免反复报错
            return False

    def _next_seq(self):
        self._seq += 1
        return self._seq

    def push(self, text):
        return self.push_item({'k': 'text', 'v': text})

    def push_item(self, item):
        v = item.get('v', '') or ''
        if item.get('k') != 'image':
            v = v.replace('\x00', '')
            if len(v) > MAX_CHARS or not v.strip():
                return False
            item['v'] = v
        item['ts'] = time.time()
        uk = self._ukey(item)

        try:
            row = self.conn.execute('SELECT id FROM items WHERE ukey=? LIMIT 1',
                                    (uk,)).fetchone()
        except Exception:
            row = None

        if row:
            _id = row[0]
            self.conn.execute('UPDATE items SET seq=?, ts=? WHERE id=?',
                              (self._next_seq(), item['ts'], _id))
            for i, it in enumerate(self.items):
                if it.get('_id') == _id:
                    old = self.items.pop(i)
                    old['ts'] = item['ts']
                    self.items.insert(0, old)
                    break
            self.save()
            return True

        k = item.get('k', 'text')
        cur = self.conn.execute(
            'INSERT INTO items(ukey,k,v,htext,p,tpath,w,ih,ts,seq)'
            ' VALUES(?,?,?,?,?,?,?,?,?,?)',
            (uk, k, item.get('v', ''),
             item.get('h') if k == 'html' else None,
             item.get('p'), item.get('t'),
             item.get('w') if k == 'image' else None,
             item.get('h') if k == 'image' else None,
             item['ts'], self._next_seq()))
        item['_id'] = cur.lastrowid
        self.items.insert(0, item)
        dropped = self._trim()
        if self.save():
            for it in dropped:
                self._purge_files(it)
        return True

    def touch(self, item):
        for i, it in enumerate(self.items):
            if it is item:
                if i != 0:
                    self.items.pop(i)
                    self.items.insert(0, it)
                it['ts'] = time.time()
                if it.get('_id'):
                    self.conn.execute('UPDATE items SET seq=?, ts=? WHERE id=?',
                                      (self._next_seq(), it['ts'], it['_id']))
                self.save()
                return

    def _trim(self):
        limit = get_max_items()
        if len(self.items) <= limit:
            return []
        dropped = self.items[limit:]
        ids = [(it['_id'],) for it in dropped if it.get('_id')]
        if not ids:
            del self.items[limit:]
            return dropped

        # DELETE 失败不等于随后 COMMIT 一定失败（例如触发器 RAISE(ABORT)），
        # 一旦把内存裁剪当成成功，就会在上层删掉对应图片，而库里仍留着这些行。
        # 这里用 SAVEPOINT 保证：删不全就整体回滚内存与数据库，且不清理任何文件。
        snapshot = list(self.items)
        del self.items[limit:]
        before = self.conn.total_changes
        try:
            self.conn.execute('SAVEPOINT trim')
            self.conn.executemany('DELETE FROM items WHERE id=?', ids)
            changed = self.conn.total_changes - before
            if changed != len(ids):
                raise sqlite3.DatabaseError(
                    '期望删除 %d 行，实际 %d 行' % (len(ids), changed))
            self.conn.execute('RELEASE trim')
        except Exception as e:
            try:
                self.conn.execute('ROLLBACK TO trim')
                self.conn.execute('RELEASE trim')
            except Exception:
                pass
            self.items[:] = snapshot          # 内存回滚，与数据库保持一致
            sys.stderr.write('[cliphist] 裁剪失败（%s），本次不删除任何条目，'
                             '也不清理图片\n' % e)
            sys.stderr.flush()
            return []
        return dropped

    def remove(self, index):
        if not (0 <= index < len(self.items)):
            return False
        snapshot = list(self.items)
        removed = self.items.pop(index)
        if removed.get('_id'):
            self.conn.execute('DELETE FROM items WHERE id=?', (removed['_id'],))
        if not self.save():
            self.items[:] = snapshot
            return False
        self._purge_files(removed)
        return True

    def clear(self):
        snapshot = list(self.items)
        self.items = []
        self.conn.execute('DELETE FROM items')
        if not self.save():
            self.items = snapshot
            return False
        for it in snapshot:
            self._purge_files(it)
        return True

    # 与 JsonStore 共用同一套图片清理规则
    _purge_files = JsonStore._purge_files


def _latest_snapshot_items():
    """读最近一份可用快照，返回条目列表；没有则返回空。"""
    try:
        names = sorted(n for n in os.listdir(SNAPSHOT_DIR) if n.endswith('.json'))
    except Exception:
        return []
    for name in reversed(names):
        try:
            with open(os.path.join(SNAPSHOT_DIR, name), 'r', encoding='utf-8') as f:
                data = json.load(f)
            if isinstance(data, list):
                return [x for x in data if isinstance(x, dict)]
        except Exception:
            continue
    return []


def Store(path):
    """按可用性选择后端：优先 sqlite；不可用时按是否已迁移区别处理。"""
    db = os.path.join(os.path.dirname(path), 'history.db')
    try:
        return SqliteStore(db, legacy_json=path)
    except Exception as e:
        # 已经迁移过（库文件或 .migrated 还在）时，绝不能另建一份独立的
        # history.json：那会形成第二份权威历史，等 sqlite 恢复后，
        # 故障期间复制的内容既不在这份 JSON 的视野里，也不会被重新导入。
        # 此时改为只读安全模式：展示最近快照，不写任何东西。
        if os.path.exists(db) or os.path.exists(path + '.migrated'):
            st = JsonStore(path)
            st.items = _latest_snapshot_items()
            st.readonly = True
            st.dirty = False
            sys.stderr.write(
                '[cliphist] sqlite 不可用（%s），进入只读安全模式：'
                '不新建 history.json，展示最近快照的 %d 条记录。\n' % (e, len(st.items)))
            sys.stderr.flush()
            return st
        sys.stderr.write('[cliphist] sqlite 存储不可用（%s），回退到 JSON 文件\n' % e)
        sys.stderr.flush()
        return JsonStore(path)


def _fix_perms():
    """把数据目录与历史文件的权限收紧到仅本人可访问（兼容已存在的旧文件）。"""
    for d in (DATA_DIR, IMG_DIR):
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
            os.chmod(d, 0o700)
        except Exception:
            pass
    try:
        os.chmod(HISTORY_FILE, 0o600)
    except Exception:
        pass


def human_time(ts):
    d = max(0, time.time() - ts)
    if d < 60:
        return '刚刚'
    if d < 3600:
        return '%d 分钟前' % int(d // 60)
    if d < 86400:
        return '%d 小时前' % int(d // 3600)
    if d < 86400 * 7:
        return '%d 天前' % int(d // 86400)
    return time.strftime('%m-%d', time.localtime(ts))


def preview(text, limit=300):
    s = ' '.join(text.split())
    if len(s) > limit:
        s = s[:limit] + '…'
    return s


def strip_html(html):
    """从 HTML 提取可读的纯文本，作为搜索与列表显示的兜底。"""
    import html as _h
    t = re.sub(r'(?is)<(script|style)\b.*?</\1>', ' ', html or '')
    t = re.sub(r'(?s)<[^>]+>', ' ', t)
    try:
        t = _h.unescape(t)
    except Exception:
        pass
    return re.sub(r'\s+', ' ', t).strip()


def uris_to_paths(blob):
    """把 text/uri-list 解析成可读的路径列表。

    文件管理器复制文件时给的是这种格式（每行一个 URI，# 开头是注释）。
    直接当纯文本存下来的话，历史里就是一串 file%3A//... 的编码串，
    既不好认也不好用；这里还原成人能读、能直接粘进终端的路径。
    """
    out = []
    for line in (blob or '').splitlines():
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('file://'):
            p = urllib.parse.unquote(line[7:])
            if p:
                out.append(p)
        else:
            out.append(line)
    return out


