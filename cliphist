def _send(cmd, timeout=2.0):
    """向已运行的 daemon 发送命令，成功返回 True。"""
    if not os.path.exists(SOCK_FILE):
        return False
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK_FILE)
        s.sendall(cmd.encode())
        s.close()
        return True
    except Exception:
        return False


def _spawn_daemon():
    # 只做两件事：判断要不要启动、启动后等 socket 就绪。
    # **不删 socket** —— 探活失败可能只是对端暂时繁忙，
    # 删掉活动 socket 会让正在服务的实例变成连不上的孤儿。
    # 残留 socket 由守护进程在拿到 flock 之后自行清理（那时才确定没人用）。
    if _socket_alive():
        return True

    exe = os.path.abspath(__file__)
    subprocess.Popen([exe, 'daemon'],
                     stdout=subprocess.DEVNULL,
                     stderr=open('/tmp/cliphist.err', 'ab'),
                     start_new_session=True)
    for _ in range(40):
        time.sleep(0.1)
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.3)
        try:
            s.connect(SOCK_FILE)
            s.close()
            return True
        except Exception:
            s.close()
    return False


def kill_stale_clients():
    """兜底清理：把还挂着 cliphist 窗口的 X 客户端从服务端强制断开。

    有些残留实例可能处在别的 PID namespace 里（pkill 够不着），
    但它们一定在 X 服务器上注册了窗口，用 XKillClient 断连最彻底。
    返回断开的数量。
    """
    try:
        out = subprocess.check_output(
            ['xwininfo', '-root', '-tree'],
            stderr=subprocess.DEVNULL).decode('utf-8', 'ignore')
    except Exception:
        return 0

    wids = re.findall(r'(0x[0-9a-f]+)\s+"cliphist"', out)
    if not wids:
        return 0

    try:
        x11 = ctypes.CDLL('libX11.so.6')
        x11.XOpenDisplay.restype = ctypes.c_void_p
        x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x11.XKillClient.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        dpy = x11.XOpenDisplay(None)
        if not dpy:
            return 0
        for w in wids:
            try:
                x11.XKillClient(dpy, int(w, 16))
            except Exception:
                pass
        x11.XSync(dpy, 0)
        return len(wids)
    except Exception:
        return 0


def _has_stale_windows():
    """是否还有挂着 cliphist 窗口的残留客户端。"""
    try:
        out = subprocess.check_output(
            ['xwininfo', '-root', '-tree'],
            stderr=subprocess.DEVNULL).decode('utf-8', 'ignore')
        return bool(re.search(r'"cliphist"', out))
    except Exception:
        return False


def _supervise():
    """父进程守着界面子进程：子进程异常退出就重启。

    本机 GTK 给所有顶层窗口分配的都是 32 位 ARGB 视觉（连普通窗口也是这样），
    每次重绘都要经 MIT-SHM 把位图上传给 X；而这条通道在这台机器上会间歇性
    报 BadValue 并直接把进程打掉（request_code 130 / minor_code 3）。
    这是环境缺陷，应用层无法绕开，但可以让它自动回来——
    否则按 Super+V 没反应，且用户不知道要去重启。

    子进程的 stderr 追加到 daemon.log：崩溃原因（Gdk-ERROR / traceback）
    都在里面，否则守护启动方式一变，日志就跟着丢了。
    """
    restarts = 0
    try:                     # 日志超过 256 KB 就轮转一份，避免无限增长
        if os.path.getsize(DAEMON_LOG) > 256 * 1024:
            os.replace(DAEMON_LOG, DAEMON_LOG + '.1')
    except Exception:
        pass
    while True:
        pid = os.fork()
        if pid == 0:
            # 子进程：只跑界面与剪贴板，不碰锁（锁由父进程持有）
            try:
                fd = os.open(DAEMON_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND,
                             0o600)
                os.dup2(fd, 2)
                os.close(fd)
            except Exception:
                pass
            code = 0
            try:
                ClipHist().run()
            except BaseException:
                import traceback
                traceback.print_exc()
                code = 1
            os._exit(code)

        try:
            _, status = os.waitpid(pid, 0)
        except OSError:
            return 1

        if os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0:
            return 0        # 正常退出（quit / stop），父进程跟着退

        if os.WIFSIGNALED(status):
            why = 'signal %d' % os.WTERMSIG(status)
        else:
            why = 'exit %d' % os.WEXITSTATUS(status)

        restarts += 1
        sys.stderr.write('[cliphist] 界面进程异常退出（%s），第 %d 次重启\n'
                         % (why, restarts))
        sys.stderr.flush()
        if restarts > 30:
            sys.stderr.write('[cliphist] 连续崩溃过多，停止重启；'
                             '详见 %s，可执行 cliphist daemon 手动再启动\n'
                             % DAEMON_LOG)
            sys.stderr.flush()
            return 1
        time.sleep(min(1.0 * restarts, 5.0))


def _maybe_reexec_noshm():
    """若本机存在禁用 MIT-SHM 的预载库，则带它重新执行自己。

    这台机器上 GDK 给所有顶层窗口分配的视觉都是 32 位，每次重绘都要经
    MIT-SHM 上传位图，而该通道会间歇性报 BadValue 把进程打掉。
    装上 noshm.so 后 XShmQueryExtension 返回 0，GDK 自动退回 XPutImage。
    库文件不存在就什么也不做，正常环境完全不受影响。
    """
    if os.environ.get('CLIPHIST_NOSHM') == '1':
        return
    shim = os.path.join(HOME, '.local', 'lib', 'cliphist', 'noshm.so')
    if not os.path.isfile(shim):
        return
    env = dict(os.environ)
    env['LD_PRELOAD'] = (shim + ' ' + env.get('LD_PRELOAD', '')).strip()
    env['CLIPHIST_NOSHM'] = '1'
    try:
        os.execve(sys.executable,
                  [sys.executable, os.path.abspath(__file__)] + sys.argv[1:],
                  env)
    except Exception:
        pass


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else 'show'

    if cmd == 'daemon':
        _maybe_reexec_noshm()
        # 单实例靠文件锁保证：拿不到锁说明已有实例活着，直接退出。
        # 比"先删 socket 再抢"可靠——删 socket 会把正在服务的实例踢成孤儿。
        lock = _try_lock()
        if lock is None:
            sys.stderr.write('[cliphist] 已有实例在运行，本次启动放弃\n')
            return 0

        # 拿到锁之后，残留的 socket 必然是上次异常退出留下的，可以放心清理。
        # 这里**不能**用 XKillClient —— 残留窗口的 resource id 会被新连接复用，
        # 强杀会把自己刚建立的连接一起断掉（Fatal IO error）。
        # 真要清理顽固残留交给 `cliphist stop`（那个进程没有窗口，安全）。
        if _send('ping'):
            _send('quit')
            for _ in range(50):
                time.sleep(0.1)
                if not _send('ping'):
                    break
        for _ in range(30):
            if not _has_stale_windows():
                break
            time.sleep(0.1)
        return _supervise()

    elif cmd in ('show', 'toggle', 'settings'):
        if not _send(cmd):
            if _spawn_daemon():
                time.sleep(0.15)
                _send(cmd)
            else:
                print('守护进程启动失败，日志见 /tmp/cliphist.err', file=sys.stderr)
                return 1

    elif cmd == 'stop':
        was = _send('quit')
        time.sleep(0.6)
        n = kill_stale_clients()
        if was or n:
            print('已停止' + ('（另清理残留实例 %d 个）' % n if n else ''))
        else:
            print('未在运行')

    elif cmd == 'status':
        if _send('ping'):
            n = len(Store(HISTORY_FILE).items)
            print('运行中，已记录 %d 条，字号 %.1f pt' % (n, get_font_size()))
        else:
            print('未运行')

    elif cmd == 'font':
        if len(sys.argv) > 2:
            try:
                v = float(sys.argv[2])
            except ValueError:
                print('用法: cliphist font <%.0f-%.0f>' % (FONT_MIN, FONT_MAX))
                return 1
            v = max(FONT_MIN, min(FONT_MAX, v))
            c = load_config()
            c['font_size'] = v
            save_config(c)
            ok = _send('reload')
            print('字号已设为 %.1f pt%s'
                  % (v, '' if ok else '（守护进程未运行，下次启动生效）'))
        else:
            print('当前字号 %.1f pt，范围 %.0f-%.0f'
                  % (get_font_size(), FONT_MIN, FONT_MAX))

    elif cmd == 'clear':
        # 守护进程在跑时必须交给它清空。否则它内存里仍是旧数据，
        # 下一次 push 会把整个文件覆盖回去（表现为「清空后记录又复活」）。
        if not _send('clear'):
            if not Store(HISTORY_FILE).clear():
                print('清空失败：历史文件无法写入', file=sys.stderr)
                return 1
        print('历史已清空')

    else:
        print(__doc__)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
