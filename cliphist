# --------------------------------------------------------------------------
# X11 全局热键（ctypes 直接调用 libX11，无需 python-xlib）
# --------------------------------------------------------------------------

class _XEvent(ctypes.Union):
    _fields_ = [('type', ctypes.c_int), ('pad', ctypes.c_long * 24)]


MOD_SUPER = 64                     # Mod4Mask
LOCK_VARIANTS = (0, 2, 16, 18)     # 无锁定 / CapsLock / NumLock / 两者
KEY_PRESS = 2


class HotkeyMonitor(threading.Thread):
    """在独立 X 连接上抓取 Super+V，触发时回调。"""

    daemon = True

    def __init__(self, callback):
        super().__init__(name='hotkey')
        self.callback = callback
        self.started_ok = False
        self._last = 0.0

    def run(self):
        try:
            x11 = ctypes.CDLL('libX11.so.6')
        except OSError:
            return

        x11.XOpenDisplay.restype = ctypes.c_void_p
        x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x11.XDefaultRootWindow.restype = ctypes.c_ulong
        x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        x11.XStringToKeysym.restype = ctypes.c_ulong
        x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
        x11.XKeysymToKeycode.restype = ctypes.c_ubyte
        x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
        x11.XGrabKey.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint,
                                 ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_int]
        x11.XSelectInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_long]
        x11.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
        x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]

        dpy = x11.XOpenDisplay(None)
        if not dpy:
            return
        self._x11 = x11

        # 抓取失败（已被别的客户端占用）时 Xlib 会抛 BadAccess，必须捕获并计数，
        # 否则进程静默活着却不响应热键，排查起来极其费劲。
        errs = []
        CB = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)

        def _on_x_error(_d, _e):
            errs.append(1)
            return 0

        self._err_cb = CB(_on_x_error)      # 必须持有引用，否则回调被 GC 回收
        x11.XSetErrorHandler.argtypes = [CB]
        x11.XSetErrorHandler.restype = ctypes.c_void_p
        prev_handler = x11.XSetErrorHandler(self._err_cb)

        root = x11.XDefaultRootWindow(dpy)
        keycode = x11.XKeysymToKeycode(dpy, x11.XStringToKeysym(b'v'))
        for extra in LOCK_VARIANTS:
            x11.XGrabKey(dpy, keycode, MOD_SUPER | extra, root, 1, 1, 1)
        x11.XSelectInput(dpy, root, 1)  # KeyPressMask
        x11.XSync(dpy, 0)

        # 抓完立刻把原来的 handler 还回去。X 的 error handler 是进程级的，
        # 一直挂着会把 GDK 的 X 错误也一并吞掉，后续排查会更困难。
        if prev_handler:
            try:
                x11.XSetErrorHandler(ctypes.cast(prev_handler, CB))
            except Exception:
                pass

        self.grab_conflicts = len(errs)
        if self.grab_conflicts:
            sys.stderr.write(
                '[cliphist] 警告：Super+V 已被其他实例占用（%d/4 个组合抓取失败），'
                '本进程将收不到热键。请先运行 cliphist stop。\n'
                % self.grab_conflicts)
            sys.stderr.flush()
        self.started_ok = True

        ev = _XEvent()
        while True:
            x11.XNextEvent(dpy, ctypes.byref(ev))
            if ev.type == KEY_PRESS:
                now = time.monotonic()
                if now - self._last < HOTKEY_DELAY_MS / 1000.0:
                    continue
                self._last = now
                GLib.idle_add(self.callback)


# --------------------------------------------------------------------------
# 历史存取
# --------------------------------------------------------------------------

class Store(object):
    """历史存储。条目结构：
       纯文本  {"k":"text",  "v":文本, "ts":...}
       富文本  {"k":"html",  "v":纯文本回退, "h":html, "ts":...}
       图片    {"k":"image", "v":"[图片 W×H]", "p":原图, "t":缩略图,
                "w":宽, "h":高, "ts":...}
       'k' 缺省按 text 处理，兼容旧版数据。
    """

    def __init__(self, path):
        self.path = path
        self.items = []
        # 隔离失败时置 True：宁可本次不写盘，也不能用空列表覆盖掉原文件
        self.readonly = False
        self.load()

    def load(self):
        try:
            with open(self.path, 'r', encoding='utf-8') as f:
                data = json.load(f)
            if not isinstance(data, list):
                raise ValueError('root is not a list')
        except FileNotFoundError:
            self.items = []          # 首次运行，正常情况
            return
        except (ValueError, UnicodeDecodeError) as e:
            # 内容本身坏了（JSON 语法错 / 编码错 / 根不是数组）：
            # 改名留档，绝不用空列表把原文件覆盖掉。
            self.items = []
            if not self._quarantine(e):
                self.readonly = True
            return
        except OSError as e:
            # 权限不足、文件被占用、路径是目录等：这是 I/O 问题，不是数据损坏。
            # 此时绝不能把文件挪走，也不能清空内存（否则下一次 save 就覆盖了）。
            self.readonly = True
            sys.stderr.write('[cliphist] 历史文件读取失败（%s），本次以只读方式运行\n'
                             % e)
            sys.stderr.flush()
            return
        except Exception as e:
            self.readonly = True
            sys.stderr.write('[cliphist] 历史文件读取异常（%s），本次以只读方式运行\n'
                             % e)
            sys.stderr.flush()
            return

        self.items = [x for x in data
                      if isinstance(x, dict) and ('v' in x or 'h' in x)]
        self.readonly = False        # 读取恢复正常后解除只读

    def _quarantine(self, err):
        """把损坏的历史改名留档。返回是否成功。文件名保证唯一，不覆盖旧备份。"""
        try:
            stamp = time.strftime('%Y%m%d-%H%M%S')
            bak = '%s.corrupt-%s' % (self.path, stamp)
            n = 1
            # 同一秒内连续损坏时不能覆盖上一份备份
            while os.path.exists(bak):
                bak = '%s.corrupt-%s-%d' % (self.path, stamp, n)
                n += 1
            os.replace(self.path, bak)
            sys.stderr.write('[cliphist] 历史文件无法解析（%s），已另存为 %s\n'
                             % (err, bak))
            sys.stderr.flush()
            return True
        except Exception as e:
            sys.stderr.write('[cliphist] 历史文件损坏且无法另存（%s），'
                             '为避免覆盖已停止写入，请手工处理 %s\n'
                             % (e, self.path))
            sys.stderr.flush()
            return False

    def save(self):
        """写盘。返回是否成功——调用方据此决定要不要清理图片、要不要回滚内存。"""
        if self.readonly:
            sys.stderr.write('[cliphist] 处于只读状态（历史文件此前读取失败），跳过保存\n')
            sys.stderr.flush()
            return False
        d = os.path.dirname(self.path)
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
        except Exception:
            pass
        tmp = self.path + '.tmp'
        try:
            # 用 0600 打开：历史里有你复制过的所有内容，不该让同机其他用户读到
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, 'w', encoding='utf-8') as f:
                json.dump(self.items, f, ensure_ascii=False)
            os.replace(tmp, self.path)
            return True
        except Exception as e:
            sys.stderr.write('[cliphist] 历史保存失败：%s\n' % e)
            sys.stderr.flush()
            try:
                os.unlink(tmp)
            except Exception:
                pass
            return False

    @staticmethod
    def _key(it):
        k = it.get('k', 'text')
        if k == 'image':
            return ('image', it.get('p', ''))
        if k == 'html':
            return ('html', it.get('h', ''))
        return ('text', it.get('v', ''))

    def push(self, text):
        """插入一条纯文本；同内容已存在则置顶。"""
        return self.push_item({'k': 'text', 'v': text})

    def push_item(self, item):
        v = item.get('v', '') or ''
        if item.get('k') != 'image':
            v = v.replace('\x00', '')
            if len(v) > MAX_CHARS or not v.strip():
                return False
            item['v'] = v
        item['ts'] = time.time()

        key = self._key(item)
        for i, it in enumerate(self.items):
            if self._key(it) == key:
                old = self.items.pop(i)
                old['ts'] = item['ts']
                self.items.insert(0, old)
                self.save()
                return True

        self.items.insert(0, item)
        dropped = self._trim()
        if self.save():
            for it in dropped:
                self._purge_files(it)    # 落盘成功后才删图片，避免 JSON 指向已删文件
        # 保存失败时条目仍留在内存里，等下一次写入机会再落盘
        return True

    def touch(self, item):
        """把条目置顶并刷新时间（面板里粘贴后调用）。"""
        for i, it in enumerate(self.items):
            if it is item:
                if i != 0:
                    self.items.pop(i)
                    self.items.insert(0, it)
                it['ts'] = time.time()
                self.save()
                return

    def _trim(self):
        """按上限裁剪内存，返回被裁掉的条目。

        这里只改内存、不删图片文件：图片要等 save() 成功之后才能删，
        否则写盘失败时 JSON 里仍引用着已经被删掉的图片。
        """
        limit = get_max_items()
        if len(self.items) <= limit:
            return []
        dropped = self.items[limit:]
        del self.items[limit:]
        return dropped

    def _purge_files(self, item):
        if item.get('k') != 'image':
            return
        base = os.path.realpath(DATA_DIR)
        for k in ('p', 't'):
            rel = item.get(k)
            if not rel:
                continue
            p = os.path.realpath(os.path.join(DATA_DIR, rel))
            # 只删数据目录内的文件：history.json 若被改坏，不至于误删外部路径
            if p.startswith(base + os.sep) and os.path.isfile(p):
                try:
                    os.unlink(p)
                except Exception:
                    pass

    def remove(self, index):
        if not (0 <= index < len(self.items)):
            return False
        snapshot = list(self.items)
        removed = self.items.pop(index)
        if not self.save():
            # 写盘失败就回滚内存：否则界面显示已删、磁盘却还在，
            # 而且图片文件已经被清掉，下次读到就是坏条目
            self.items[:] = snapshot
            return False
        self._purge_files(removed)
        return True

    def clear(self):
        snapshot = list(self.items)
        self.items = []
        if not self.save():
            self.items = snapshot
            return False
        # 落盘成功后再清理图片文件
        for it in snapshot:
            self._purge_files(it)
        return True


def _fix_perms():
    """把数据目录与历史文件的权限收紧到仅本人可访问（兼容已存在的旧文件）。"""
    for d in (DATA_DIR, IMG_DIR):
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
            os.chmod(d, 0o700)
        except Exception:
            pass
    try:
        os.chmod(HISTORY_FILE, 0o600)
    except Exception:
        pass


def human_time(ts):
    d = max(0, time.time() - ts)
    if d < 60:
        return '刚刚'
    if d < 3600:
        return '%d 分钟前' % int(d // 60)
    if d < 86400:
        return '%d 小时前' % int(d // 3600)
    if d < 86400 * 7:
        return '%d 天前' % int(d // 86400)
    return time.strftime('%m-%d', time.localtime(ts))


def preview(text, limit=300):
    s = ' '.join(text.split())
    if len(s) > limit:
        s = s[:limit] + '…'
    return s


def strip_html(html):
    """从 HTML 提取可读的纯文本，作为搜索与列表显示的兜底。"""
    import html as _h
    t = re.sub(r'(?is)<(script|style)\b.*?</\1>', ' ', html or '')
    t = re.sub(r'(?s)<[^>]+>', ' ', t)
    try:
        t = _h.unescape(t)
    except Exception:
        pass
    return re.sub(r'\s+', ' ', t).strip()


