# 历史存取
# --------------------------------------------------------------------------

class JsonStore(object):
    """JSON 存储（旧格式，保留作为 sqlite 不可用时的兜底）。条目结构：
       纯文本  {"k":"text",  "v":文本, "ts":...}
       富文本  {"k":"html",  "v":纯文本回退, "h":html, "ts":...}
       图片    {"k":"image", "v":"[图片 W×H]", "p":原图, "t":缩略图,
                "w":宽, "h":高, "ts":...}
       'k' 缺省按 text 处理，兼容旧版数据。
    """

    def __init__(self, path):
        self.path = path
        self.items = []
        # 隔离失败时置 True：宁可本次不写盘，也不能用空列表覆盖掉原文件
        self.readonly = False
        # 内存中有尚未落盘的改动。此时绝不能从磁盘重读，否则改动凭空消失
        self.dirty = False
        self.load()

    def load(self):
        if self.dirty:
            # 内存里有没写成功的条目，重读磁盘会把它们抹掉。
            # 保留内存状态，等下一次 save() 有机会再落盘。
            sys.stderr.write('[cliphist] 存在未保存的改动，跳过重新读取历史文件\n')
            sys.stderr.flush()
            return
        try:
            with open(self.path, 'r', encoding='utf-8') as f:
                data = json.load(f)
            if not isinstance(data, list):
                raise ValueError('root is not a list')
        except FileNotFoundError:
            self.items = []          # 首次运行，正常情况
            return
        except (ValueError, UnicodeDecodeError) as e:
            # 内容本身坏了（JSON 语法错 / 编码错 / 根不是数组）：
            # 改名留档，绝不用空列表把原文件覆盖掉。
            self.items = []
            if not self._quarantine(e):
                self.readonly = True
            return
        except OSError as e:
            # 权限不足、文件被占用、路径是目录等：这是 I/O 问题，不是数据损坏。
            # 此时绝不能把文件挪走，也不能清空内存（否则下一次 save 就覆盖了）。
            self.readonly = True
            sys.stderr.write('[cliphist] 历史文件读取失败（%s），本次以只读方式运行\n'
                             % e)
            sys.stderr.flush()
            return
        except Exception as e:
            self.readonly = True
            sys.stderr.write('[cliphist] 历史文件读取异常（%s），本次以只读方式运行\n'
                             % e)
            sys.stderr.flush()
            return

        self.items = [x for x in data
                      if isinstance(x, dict) and ('v' in x or 'h' in x)]
        self.readonly = False        # 读取恢复正常后解除只读

    def _quarantine(self, err):
        """把损坏的历史改名留档。返回是否成功。文件名保证唯一，不覆盖旧备份。"""
        try:
            stamp = time.strftime('%Y%m%d-%H%M%S')
            bak = '%s.corrupt-%s' % (self.path, stamp)
            n = 1
            # 同一秒内连续损坏时不能覆盖上一份备份
            while os.path.exists(bak):
                bak = '%s.corrupt-%s-%d' % (self.path, stamp, n)
                n += 1
            os.replace(self.path, bak)
            sys.stderr.write('[cliphist] 历史文件无法解析（%s），已另存为 %s\n'
                             % (err, bak))
            sys.stderr.flush()
            return True
        except Exception as e:
            sys.stderr.write('[cliphist] 历史文件损坏且无法另存（%s），'
                             '为避免覆盖已停止写入，请手工处理 %s\n'
                             % (e, self.path))
            sys.stderr.flush()
            return False

    def save(self):
        """写盘。返回是否成功——调用方据此决定要不要清理图片、要不要回滚内存。"""
        if self.readonly:
            sys.stderr.write('[cliphist] 处于只读状态（历史文件此前读取失败），跳过保存\n')
            sys.stderr.flush()
            self.dirty = True
            return False
        d = os.path.dirname(self.path)
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
        except Exception:
            pass
        tmp = self.path + '.tmp'
        try:
            # 用 0600 打开：历史里有你复制过的所有内容，不该让同机其他用户读到
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, 'w', encoding='utf-8') as f:
                json.dump(self.items, f, ensure_ascii=False)
            os.replace(tmp, self.path)
            self.dirty = False
            return True
        except Exception as e:
            sys.stderr.write('[cliphist] 历史保存失败：%s\n' % e)
            sys.stderr.flush()
            self.dirty = True
            try:
                os.unlink(tmp)
            except Exception:
                pass
            return False

    @staticmethod
    def _key(it):
        k = it.get('k', 'text')
        if k == 'image':
            return ('image', it.get('p', ''))
        if k == 'html':
            return ('html', it.get('h', ''))
        if k == 'file':
            return ('file', it.get('v', ''))
        return ('text', it.get('v', ''))

    def push(self, text):
        """插入一条纯文本；同内容已存在则置顶。"""
        return self.push_item({'k': 'text', 'v': text})

    def push_item(self, item):
        v = item.get('v', '') or ''
        if item.get('k') != 'image':
            v = v.replace('\x00', '')
            if len(v) > MAX_CHARS or not v.strip():
                return False
            item['v'] = v
        item['ts'] = time.time()

        key = self._key(item)
        for i, it in enumerate(self.items):
            if self._key(it) == key:
                old = self.items.pop(i)
                old['ts'] = item['ts']
                self.items.insert(0, old)
                self.save()
                return True

        self.items.insert(0, item)
        dropped = self._trim()
        if self.save():
            for it in dropped:
                self._purge_files(it)    # 落盘成功后才删图片，避免 JSON 指向已删文件
        # 保存失败时条目仍留在内存里，等下一次写入机会再落盘
        return True

    def touch(self, item):
        """把条目置顶并刷新时间（面板里粘贴后调用）。"""
        for i, it in enumerate(self.items):
            if it is item:
                if i != 0:
                    self.items.pop(i)
                    self.items.insert(0, it)
                it['ts'] = time.time()
                self.save()
                return

    def _trim(self):
        """按上限裁剪内存，返回被裁掉的条目。

        这里只改内存、不删图片文件：图片要等 save() 成功之后才能删，
        否则写盘失败时 JSON 里仍引用着已经被删掉的图片。
        """
        limit = get_max_items()
        if len(self.items) <= limit:
            return []
        dropped = self.items[limit:]
        del self.items[limit:]
        return dropped

    def _purge_files(self, item):
        """删除条目引用的图片文件。

        历史文件是可以被改坏的：只校验「在数据目录内」时，一条
        p="history.json" 的伪图片记录就能把历史自己删掉；而
        images/img_x.png 若是个指向别的图片的符号链接，先 realpath
        再判断会把链接目标当成待删文件。因此这里的校验顺序是：

        1. 相对路径必须严格是 images/(th_)img_<16位小写hex>.png
        2. 原始候选路径不能是符号链接（realpath 之前判断）
        3. 解析后的真实路径必须落在 IMG_DIR 内
        4. 必须存在且是普通文件
        """
        if item.get('k') != 'image':
            return
        base = os.path.realpath(IMG_DIR)
        for k in ('p', 't'):
            rel = item.get(k)
            if not isinstance(rel, str) or not IMG_REL_RE.match(rel):
                continue                      # 路径格式不对，一律不碰
            raw = os.path.join(DATA_DIR, rel)
            if os.path.islink(raw):
                continue                      # 原路径就是符号链接，拒绝
            p = os.path.realpath(raw)
            if not p.startswith(base + os.sep):
                continue                      # 解析后跑出图片目录
            if os.path.islink(p) or not os.path.isfile(p):
                continue                      # 二次确认（防竞态）
            try:
                os.unlink(p)
            except Exception:
                pass

    def remove(self, index):
        if not (0 <= index < len(self.items)):
            return False
        snapshot = list(self.items)
        removed = self.items.pop(index)
        if not self.save():
            # 写盘失败就回滚内存：否则界面显示已删、磁盘却还在，
            # 而且图片文件已经被清掉，下次读到就是坏条目
            self.items[:] = snapshot
            return False
        self._purge_files(removed)
        return True

    def clear(self):
        snapshot = list(self.items)
        self.items = []
        if not self.save():
            self.items = snapshot
            return False
        # 落盘成功后再清理图片文件
        for it in snapshot:
            self._purge_files(it)
        return True


