def build_css(fs):
    """按基准字号生成 CSS；正文 = fs，辅助 = 0.8fs，小标题 = 0.9fs。"""
    s = (BASE_CSS
         .replace('__FS_S__', '%.1f' % (fs * 0.80))
         .replace('__FS_H__', '%.1f' % (fs * 0.90))
         .replace('__FS__', '%.1f' % fs))
    return s.encode('utf-8')


def draw_panel_bg(widget, cr):
    """自绘圆角面板底：可调透明度的白底 + 细边框（主面板与设置窗共用）。"""
    alloc = widget.get_allocation()
    w, h = alloc.width, alloc.height
    r = 12.0
    alpha = get_opacity()

    cr.set_operator(cairo.OPERATOR_CLEAR)
    cr.paint()
    cr.set_operator(cairo.OPERATOR_SOURCE)

    cr.new_sub_path()
    cr.arc(w - r - 0.5, r + 0.5, r, -math.pi / 2, 0)
    cr.arc(w - r - 0.5, h - r - 0.5, r, 0, math.pi / 2)
    cr.arc(r + 0.5, h - r - 0.5, r, math.pi / 2, math.pi)
    cr.arc(r + 0.5, r + 0.5, r, math.pi, 1.5 * math.pi)
    cr.close_path()

    cr.set_source_rgba(1.0, 1.0, 1.0, alpha)
    cr.fill_preserve()
    cr.set_source_rgba(0.0, 0.0, 0.0, 0.18 * alpha)
    cr.set_line_width(1.0)
    cr.stroke()
    cr.set_operator(cairo.OPERATOR_OVER)
    return False


class ClipPanel(object):
    WIN_W = 500
    WIN_H = 620

    def __init__(self, app):
        self.app = app
        self.store = app.store
        self.visible_items = []
        self.prev_window = None
        self.win = None
        self._pos_timer = None
        self._search_timer = None
        self._notify_timer = None
        self._build()

    # ---------------- 构建 ----------------

    def _build(self):
        self._provider = None
        self._install_css()

        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.set_keep_above(True)
        win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        win.set_accept_focus(True)
        win.set_focus_on_map(True)
        win.set_default_size(self.WIN_W, self.WIN_H)
        win.get_style_context().add_class('clipwin')
        win.set_title('cliphist')       # 显式设标题，不依赖 GTK 用程序名兜底

        win.connect('delete-event', lambda w, e: (w.hide(), True)[1])
        win.connect('focus-out-event', self._on_focus_out)
        win.connect('key-press-event', self._on_window_key)
        win.connect('configure-event', self._on_configure)

        # 有 ARGB 视觉时用 cairo 自绘圆角；否则退化为不透明白底矩形。
        # 默认不走 ARGB —— 见 get_argb() 的说明，本环境走 32 位视觉会崩。
        self._rounded = False
        if cairo is not None and get_argb():
            try:
                visual = win.get_screen().get_rgba_visual()
                if visual is not None:
                    win.set_visual(visual)
                    win.set_app_paintable(True)
                    win.connect('draw', self._on_draw)
                    self._rounded = True
            except Exception:
                self._rounded = False

        # EventBox 有独立绘制窗口，背景色能稳定落在面板上
        # 窗口本身是矩形，CSS 圆角只在内部面板上生效，四角会露出窗口底色。
        # 把底色设成与边框同色，圆角看起来就连贯了。
        try:
            win.override_background_color(
                Gtk.StateFlags.NORMAL,
                Gdk.RGBA(0x9a / 255.0, 0xa3 / 255.0, 0xad / 255.0, 1.0))
        except Exception:
            pass

        eb = Gtk.EventBox()
        eb.get_style_context().add_class(
            'panel-trans' if self._rounded else 'panel')
        if not self._rounded:
            eb.override_background_color(Gtk.StateFlags.NORMAL,
                                         Gdk.RGBA(1.0, 1.0, 1.0, 1.0))
        else:
            eb.override_background_color(Gtk.StateFlags.NORMAL,
                                         Gdk.RGBA(1.0, 1.0, 1.0, 0.0))
        win.add(eb)

        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        frame.set_spacing(0)
        eb.add(frame)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.set_margin_top(12)
        outer.set_margin_bottom(10)
        outer.set_margin_start(14)
        outer.set_margin_end(14)
        outer.set_spacing(9)
        frame.pack_start(outer, True, True, 0)

        # 标题行：包一层 EventBox，按住即可拖动窗口
        head_eb = Gtk.EventBox()
        head_eb.connect('button-press-event', self._on_title_press)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        title = Gtk.Label(label='剪贴板历史')
        title.get_style_context().add_class('head')
        head.pack_start(title, False, False, 2)
        drag_hint = Gtk.Label(label='按住可拖动')
        drag_hint.get_style_context().add_class('draghint')
        head.pack_end(drag_hint, False, False, 4)
        head_eb.add(head)
        outer.pack_start(head_eb, False, False, 0)

        # 搜索框
        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text('搜索剪贴板历史…')
        self.entry.get_style_context().add_class('search')
        self.entry.connect('changed', self._on_search)
        self.entry.connect('key-press-event', self._on_entry_key)
        outer.pack_start(self.entry, False, False, 0)

        # 列表
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_shadow_type(Gtk.ShadowType.NONE)
        scroll.set_vexpand(True)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.set_activate_on_single_click(True)
        self.listbox.set_can_focus(False)
        self.listbox.connect('row-activated', self._on_row_activated)
        scroll.add(self.listbox)
        self.scroll = scroll
        outer.pack_start(scroll, True, True, 0)

        # 底部操作栏：提示 + 设置齿轮
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        bar.set_spacing(6)
        self.hint = Gtk.Label(label=HINT_DEFAULT)
        self.hint.get_style_context().add_class('hint')
        self.hint.set_xalign(0.0)
        self.hint.set_ellipsize(Pango.EllipsizeMode.END)
        self.hint.set_width_chars(1)
        bar.pack_start(self.hint, True, True, 0)

        # 用 EventBox+Label 而不是 Gtk.Button：按钮的边框在 UKUI 主题下是位图资源，
        # 本环境位图上传（MIT-SHM）会崩，Label 是纯矢量，安全。
        gear = Gtk.EventBox()
        gear.set_tooltip_text('字号 / 透明度 / 条目数')
        glbl = Gtk.Label(label='设置')
        glbl.get_style_context().add_class('gearbtn')
        gear.add(glbl)
        gear.connect('button-release-event',
                     lambda w, e: (self._open_settings(), True)[1])
        bar.pack_end(gear, False, False, 0)

        outer.pack_start(bar, False, False, 0)

        self.win = win

    def _open_settings(self, *_):
        self.app.open_settings()

    def _install_css(self):
        screen = Gdk.Screen.get_default()
        if self._provider is not None:
            Gtk.StyleContext.remove_provider_for_screen(screen, self._provider)
        self._provider = Gtk.CssProvider()
        self._provider.load_from_data(build_css(get_font_size()))
        Gtk.StyleContext.add_provider_for_screen(
            screen, self._provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def reload_css(self):
        """改字号/透明度后热重载，无需重启进程。"""
        load_config(force=True)     # CLI 可能刚改过配置文件，这里必须重读
        self._install_css()
        self._rebuild()
        if self._rounded:
            self.win.queue_draw()          # 背景透明度靠重绘生效
        else:
            self.win.set_opacity(get_opacity())
        return False

    def _on_draw(self, widget, cr):
        if not self._rounded:
            return False
        return draw_panel_bg(widget, cr)

    # ---------------- 显示 / 隐藏 ----------------

    def is_visible(self):
        return self.win.get_visible()

    def toggle(self):
        if self.is_visible():
            self.hide()
        else:
            self.show()

    def show(self):
        # 不再每次打开都 store.load()：内存里的 items 就是最新状态，
        # 而外部改历史现在都走 IPC。这里重读等于每次唤出都读一遍整份历史。
        self.prev_window = self._active_window()
        if self._search_timer:
            GLib.source_remove(self._search_timer)
            self._search_timer = None
        self.entry.set_text('')
        self._rebuild()
        self.win.show_all()
        self._place()          # 必须在 map 之后再定位，否则 WM 忽略
        self.win.present()
        self._shown_at = time.time()
        self.entry.grab_focus()
        if self.visible_items:
            self.listbox.select_row(self.listbox.get_row_at_index(0))

    def hide(self):
        self.win.hide()

    def _place(self):
        """定位：优先回到上次拖到的位置；首次则贴着鼠标弹出，而不是死板居中。"""
        try:
            screen = self.win.get_screen()
            w, h = self.WIN_W, self.WIN_H

            mx = my = None
            disp = None
            try:
                disp = Gdk.Display.get_default()
                _ok, mx, my = disp.get_default_seat().get_pointer().get_position()
            except Exception:
                pass

            # 跟随鼠标所在的那块屏幕，多显示器下不会一律弹到主屏
            mon = None
            if disp is not None and mx is not None:
                try:
                    m = disp.get_monitor_at_point(mx, my)
                    if m is not None:
                        mon = m.get_geometry()
                except Exception:
                    mon = None
            if mon is None:
                mon = screen.get_monitor_geometry(screen.get_primary_monitor())

            cfg = load_config()
            px, py = cfg.get('pos_x'), cfg.get('pos_y')

            if isinstance(px, (int, float)) and isinstance(py, (int, float)):
                x, y = int(px), int(py)
            elif mx is not None:
                x, y = mx - w // 2, my + 18
            else:
                x = mon.x + (mon.width - w) // 2
                y = mon.y + int((mon.height - h) * 0.42)

            # 夹在屏幕内，避免上次的位置在换了分辨率后跑到屏幕外
            x = max(mon.x, min(mon.x + mon.width - w, x))
            y = max(mon.y, min(mon.y + mon.height - h, y))
            self.win.move(x, y)
        except Exception:
            pass

    def _on_title_press(self, widget, event):
        """按住标题栏拖动窗口。"""
        if event.button == 1:
            try:
                self.win.begin_move_drag(event.button, int(event.x_root),
                                         int(event.y_root), event.time)
            except Exception:
                pass
            return True
        return False

    def _on_configure(self, widget, event):
        """窗口被移动后记下位置（防抖，避免拖动过程中频繁写盘）。"""
        if not self.win.get_visible():
            return False
        if self._pos_timer:
            GLib.source_remove(self._pos_timer)
        self._pos_timer = GLib.timeout_add(
            600, self._save_pos, event.x, event.y)
        return False

    def _save_pos(self, x, y):
        self._pos_timer = None
        cfg = load_config()
        cfg['pos_x'] = int(x)
        cfg['pos_y'] = int(y)
        save_config(cfg)
        return False

    def _active_window(self):
        try:
            out = subprocess.check_output(
                ['xdotool', 'getactivewindow'], stderr=subprocess.DEVNULL)
            return out.decode().strip()
        except Exception:
            return None

    def _on_focus_out(self, w, e):
        # 点击别处自动收起（给 250ms 宽限，避免刚弹出就被误判）
        GLib.timeout_add(250, self._hide_if_unfocused)
        return False

    def _hide_if_unfocused(self):
        if not self.win.get_visible():
            return False
        if time.time() - getattr(self, '_shown_at', 0) < 0.35:
            return False
        if not self.win.is_active():
            self.hide()
        return False

    # ---------------- 列表 ----------------

    def _rebuild(self):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

        kw = self.entry.get_text().strip().lower()
        items = self.store.items
        if kw:
            items = [it for it in items if kw in it.get('v', '').lower()]
        total = len(items)
        if total > MAX_RENDER:      # 图片行含缩略图，一次渲染太多会明显卡顿
            items = items[:MAX_RENDER]
        self.visible_items = items
        self.hint.set_text(HINT_DEFAULT)

        if not items:
            row = Gtk.ListBoxRow()
            row.set_selectable(False)
            row.set_activatable(False)
            lbl = Gtk.Label()
            lbl.get_style_context().add_class('empty')
            lbl.set_text('暂无记录' if not kw else '没有匹配的记录')
            lbl.set_margin_top(40)
            lbl.set_margin_bottom(40)
            row.add(lbl)
            self.listbox.add(row)
            row.show_all()
            return

        for it in items:
            self.listbox.add(self._make_row(it))
        self.listbox.show_all()
        if total > MAX_RENDER:
            self.hint.set_text('显示前 %d 条（共 %d 条），输入关键词可精确查找'
                               % (MAX_RENDER, total))

    def _make_row(self, it):
        row = Gtk.ListBoxRow()
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        box.get_style_context().add_class('item')
        box.set_spacing(10)
        kind = it.get('k', 'text')

        if kind == 'image':
            img = self._thumb_widget(it)
            box.pack_start(img, False, False, 0)
            lbl = Gtk.Label()
            lbl.get_style_context().add_class('item-title')
            lbl.set_text(it.get('v', '[图片]'))
            lbl.set_xalign(0.0)
            lbl.set_hexpand(True)
            lbl.set_width_chars(1)
            lbl.set_ellipsize(Pango.EllipsizeMode.END)
            box.pack_start(lbl, True, True, 0)
        else:
            lbl = Gtk.Label()
            lbl.get_style_context().add_class('item-title')
            lbl.set_text(preview(it.get('v', '')))
            lbl.set_xalign(0.0)
            lbl.set_line_wrap(True)
            lbl.set_line_wrap_mode(Pango.WrapMode.CHAR)
            lbl.set_lines(2)
            lbl.set_ellipsize(Pango.EllipsizeMode.END)
            lbl.set_hexpand(True)
            lbl.set_width_chars(1)   # 不撑开父容器，交由 ellipsize 截断
            box.pack_start(lbl, True, True, 0)

            if kind == 'html':
                badge = Gtk.Label()
                badge.get_style_context().add_class('badge')
                badge.set_text('富文本')
                badge.set_valign(Gtk.Align.START)
                badge.set_tooltip_text('含格式，粘贴时保留样式')
                box.pack_start(badge, False, False, 0)
            elif kind == 'file':
                badge = Gtk.Label()
                badge.get_style_context().add_class('badge')
                n = it.get('v', '').count('\n') + 1
                badge.set_text('文件' if n == 1 else '文件 ×%d' % n)
                badge.set_valign(Gtk.Align.START)
                badge.set_tooltip_text('粘贴时写入文件路径')
                box.pack_start(badge, False, False, 0)

        t = Gtk.Label()
        t.get_style_context().add_class('item-time')
        t.set_text(human_time(it.get('ts', time.time())))
        t.set_valign(Gtk.Align.START)
        t.set_xalign(1.0)
        t.set_width_chars(7)
        t.set_max_width_chars(7)
        box.pack_start(t, False, False, 0)

        row.add(box)
        row.item_data = it
        row.show_all()      # 显式递归显示：ListBox 内嵌 Gtk.Image 有时不随父级 show
        return row

    def _thumb_widget(self, it):
        """列表缩略图。

        默认不画——本环境下 GDK 通过 MIT-SHM 上传位图会报 BadValue 并崩进程
        （Gtk.Image 渲染不出来，Gdk.cairo_set_source_pixbuf 直接段错误，
        DrawingArea 跑两三分钟后 ShmPutImage 崩）。只有在设置里手动打开
        缩略图，才走 cairo ImageSurface 这条路。
        """
        ph = Gtk.Label(label='[图]')
        ph.get_style_context().add_class('item-time')
        ph.set_size_request(40, THUMB_H)

        if not get_show_thumbs():
            return ph

        rel = it.get('t') or it.get('p') or ''
        path = os.path.join(DATA_DIR, rel) if rel else ''
        surf = None
        if path and os.path.exists(path):
            try:
                surf = cairo.ImageSurface.create_from_png(path)
            except Exception:
                surf = None
        if surf is None:
            return ph

        da = Gtk.DrawingArea()
        da.set_size_request(surf.get_width(), surf.get_height())
        da.set_valign(Gtk.Align.CENTER)

        def _draw(_w, cr, s=surf):
            cr.set_source_surface(s, 0, 0)
            cr.paint()
            return False

        da.connect('draw', _draw)
        return da

    def _on_search(self, entry):
        # 每敲一个字符就重建 80 行代价太大，这里合并成 120ms 一次
        if self._search_timer:
            GLib.source_remove(self._search_timer)
        self._search_timer = GLib.timeout_add(120, self._do_search)

    def _do_search(self):
        self._search_timer = None
        self._rebuild()
        rows = self.listbox.get_children()
        if rows and rows[0].get_selectable():
            self.listbox.select_row(rows[0])
        return False

    def _flush_search(self):
        """把还在防抖窗口里的搜索立刻执行掉。

        否则「输入关键词后马上回车」时，列表还是过滤前的内容，
        选中的也是过滤前的第一条 —— 会粘出完全不相干的旧记录。
        """
        if self._search_timer:
            GLib.source_remove(self._search_timer)
            self._search_timer = None
            self._do_search()

    # ---------------- 键盘 ----------------

    def _move_selection(self, delta):
        rows = [r for r in self.listbox.get_children() if r.get_selectable()]
        if not rows:
            return
        cur = self.listbox.get_selected_row()
        idx = rows.index(cur) if cur in rows else -1
        idx = max(0, min(len(rows) - 1, idx + delta))
        self.listbox.select_row(rows[idx])
        self._scroll_to(rows[idx])

    def _scroll_to(self, row):
        try:
            adj = self.scroll.get_vadjustment()
            alloc = row.get_allocation()
            top = adj.get_value()
            bottom = top + adj.get_page_size()
            if alloc.y < top:
                adj.set_value(alloc.y)
            elif alloc.y + alloc.height > bottom:
                adj.set_value(alloc.y + alloc.height - adj.get_page_size())
        except Exception:
            pass

    def _on_entry_key(self, widget, event):
        k = event.keyval
        if k == Gdk.KEY_Down:
            self._move_selection(1)
            return True
        if k == Gdk.KEY_Up:
            self._move_selection(-1)
            return True
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self._flush_search()
            self._activate_selected()
            return True
        if k == Gdk.KEY_Escape:
            self.hide()
            return True
        if k == Gdk.KEY_Delete:
            # 搜索框为空时 Del 直接删条目；有内容时 Del 保持原义（删字符），
            # 想删条目则用 Ctrl+Del。这样和底部「Del 删除」的提示一致。
            if (event.state & Gdk.ModifierType.CONTROL_MASK) \
                    or not self.entry.get_text():
                self._flush_search()
                self._delete_selected()
                return True
        return False

    def _on_window_key(self, widget, event):
        k = event.keyval
        if k == Gdk.KEY_Escape:
            self.hide()
            return True
        if k == Gdk.KEY_Down:
            self._move_selection(1)
            return True
        if k == Gdk.KEY_Up:
            self._move_selection(-1)
            return True
        return False

    # ---------------- 动作 ----------------

    def _notify(self, msg):
        """在底部提示位临时显示一条消息，2.5 秒后恢复。"""
        try:
            if getattr(self, '_notify_timer', None):
                GLib.source_remove(self._notify_timer)
            self.hint.set_text(msg)
            self._notify_timer = GLib.timeout_add(2500, self._restore_hint)
        except Exception:
            pass

    def _restore_hint(self):
        self._notify_timer = None
        try:
            self.hint.set_text(HINT_DEFAULT)
        except Exception:
            pass
        return False

    def _delete_selected(self):
        row = self.listbox.get_selected_row()
        if not row or not hasattr(row, 'item_data'):
            return
        target = row.item_data
        idx = row.get_index()
        for i, it in enumerate(self.store.items):
            if it is target:
                if not self.store.remove(i):
                    self._notify('删除失败：历史文件无法写入')
                    return
                break
        self._rebuild()
        # 删完把选中落在原位置（或最后一条），方便连续删除
        rows = [r for r in self.listbox.get_children() if r.get_selectable()]
        if rows:
            self.listbox.select_row(rows[min(idx, len(rows) - 1)])

    def _on_row_activated(self, lb, row):
        if hasattr(row, 'item_data'):
            self._paste(row.item_data)

    def _activate_selected(self):
        row = self.listbox.get_selected_row()
        if row and hasattr(row, 'item_data'):
            self._paste(row.item_data)

    def _paste(self, item):
        if not item:
            return
        prev = self.prev_window
        self.hide()
        if not self.app.set_clipboard(item):
            # 写剪贴板失败就别发 Ctrl+V 了，否则会把剪贴板里的旧内容粘出去
            return
        GLib.timeout_add(180, self._send_keys, prev)

    def _send_keys(self, prev):
        # 没有记录到目标窗口就放弃自动粘贴：此时焦点在哪不可知，
        # 盲发 Ctrl+V 可能粘到别的窗口里。内容已在剪贴板，手动按即可。
        if not prev:
            return False

        def work():
            # 激活是阻塞调用，放到线程里做，避免卡住 GTK 主线程
            try:
                r = subprocess.run(
                    ['xdotool', 'windowactivate', '--sync', str(prev)],
                    timeout=1.5, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)
                if r.returncode != 0:
                    return
            except Exception:
                return          # 超时 / xdotool 缺失，都不该盲发按键
            try:
                subprocess.Popen(['xdotool', 'key', '--clearmodifiers', 'ctrl+v'],
                                 stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)
            except Exception:
                pass

        threading.Thread(target=work, daemon=True).start()
        return False


class SettingsDialog(object):
    """设置面板：字号 / 背景透明度 / 历史条目上限。

    刻意不用 Gtk.Scale / SpinButton / CheckButton / Button —— 它们的滑块、
    箭头、勾选框在 UKUI 主题下走位图资源，而本环境的位图上传（MIT-SHM
    ShmPutImage）是坏的，窗口一显示就崩进程（已用最小用例复现）。
    这里只用 Label / Entry / EventBox / Box 这些纯矢量控件。
    """

    def __init__(self, app):
        self.app = app
        self.win = None
        self._rounded = False       # 设置窗口不用 ARGB，边框交给 CSS 画
        self._build()

    def _build(self):
        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_skip_taskbar_hint(True)
        win.set_keep_above(True)
        win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        win.set_position(Gtk.WindowPosition.CENTER)
        win.set_default_size(420, 330)
        win.get_style_context().add_class('clipwin')
        win.set_title('cliphist-settings')
        win.connect('delete-event', lambda w, e: (w.hide(), True)[1])
        win.connect('key-press-event', self._on_key)

        # 窗口本身是矩形，CSS 圆角只在内部面板上生效，四角会露出窗口底色。
        # 把底色设成与边框同色，圆角看起来就连贯了。
        try:
            win.override_background_color(
                Gtk.StateFlags.NORMAL,
                Gdk.RGBA(0x9a / 255.0, 0xa3 / 255.0, 0xad / 255.0, 1.0))
        except Exception:
            pass

        eb = Gtk.EventBox()
        eb.get_style_context().add_class(
            'panel-trans' if self._rounded else 'panel')
        eb.override_background_color(Gtk.StateFlags.NORMAL,
                                     Gdk.RGBA(1, 1, 1, 1))
        win.add(eb)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.set_margin_top(16)
        box.set_margin_bottom(14)
        box.set_margin_start(20)
        box.set_margin_end(20)
        box.set_spacing(9)
        eb.add(box)

        title = Gtk.Label(label='设置')
        title.get_style_context().add_class('settings-title')
        title.set_xalign(0.0)
        box.pack_start(title, False, False, 0)

        self.font_entry, row = self._num_row(
            '文字大小（8–20 pt）', '%.1f' % get_font_size(), 6)
        box.pack_start(row, False, False, 0)

        self.op_entry, row = self._num_row(
            '背景透明度（50–100%）', '%.0f' % (get_opacity() * 100), 6)
        box.pack_start(row, False, False, 0)

        self.cnt_entry, row = self._num_row(
            '历史条目上限（50–5000）', '%d' % get_max_items(), 8)
        box.pack_start(row, False, False, 0)

        tip = Gtk.Label(label='按回车立即生效，或点「完成」一并保存')
        tip.get_style_context().add_class('settings-value')
        tip.set_xalign(0.0)
        tip.set_margin_top(2)
        box.pack_start(tip, False, False, 0)

        btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        btns.set_spacing(12)
        btns.set_margin_top(10)
        btns.pack_start(self._text_button('恢复默认', self._reset), False, False, 0)
        btns.pack_end(self._text_button('完成', self._commit_and_close), False, False, 0)
        box.pack_end(btns, False, False, 0)

        self.win = win

    def _num_row(self, label, value, width):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        row.set_spacing(10)
        lbl = Gtk.Label(label=label)
        lbl.get_style_context().add_class('settings-label')
        lbl.set_xalign(0.0)
        row.pack_start(lbl, True, True, 0)
        entry = Gtk.Entry()
        entry.set_text(value)
        entry.set_width_chars(width)
        entry.set_max_width_chars(width)
        entry.set_alignment(1.0)
        entry.connect('activate', self._commit)
        row.pack_end(entry, False, False, 0)
        return entry, row

    def _text_button(self, text, cb):
        eb = Gtk.EventBox()
        lbl = Gtk.Label(label=text)
        lbl.get_style_context().add_class('btn')
        eb.add(lbl)
        eb.connect('button-release-event', lambda w, e: (cb(), True)[1])
        return eb

    def _commit(self, *_):
        try:
            fs = float(self.font_entry.get_text().strip())
        except Exception:
            fs = get_font_size()
        try:
            op = float(self.op_entry.get_text().strip().rstrip('%'))
        except Exception:
            op = get_opacity() * 100
        try:
            cnt = int(float(self.cnt_entry.get_text().strip()))
        except Exception:
            cnt = get_max_items()

        fs = max(FONT_MIN, min(FONT_MAX, fs))
        op = max(50.0, min(100.0, op))
        cnt = max(50, min(5000, cnt))

        cfg = load_config()
        cfg['font_size'] = round(fs, 1)
        cfg['opacity'] = round(op / 100.0, 2)
        cfg['max_items'] = cnt
        save_config(cfg)
        # 上限调小后立即裁掉多余条目，不用等下一次 push
        dropped = self.app.store._trim()
        if self.app.store.save():
            for it in dropped:
                self.app.store._purge_files(it)
        self.apply()
        self._refill()
        return False

    def apply(self):
        panel = self.app.panel
        panel._install_css()
        # 不重读历史：运行期内存里的 items 就是最新状态，
        # 重读会把「写盘失败、仅存于内存」的条目直接抹掉。
        panel._rebuild()
        if panel._rounded:
            panel.win.queue_draw()
        else:
            panel.win.set_opacity(get_opacity())

    def _commit_and_close(self):
        # 点「完成」时也要提交一次：用户很可能改完数字直接点按钮，
        # 不回车就关掉会静默丢失改动。
        self._commit()
        self.hide()

    def _reset(self):
        self.font_entry.set_text('%.1f' % DEFAULT_FONT)
        self.op_entry.set_text('100')
        self.cnt_entry.set_text(str(MAX_ITEMS))
        self._commit()

    def _refill(self):
        self.font_entry.set_text('%.1f' % get_font_size())
        self.op_entry.set_text('%.0f' % (get_opacity() * 100))
        self.cnt_entry.set_text('%d' % get_max_items())

    def _on_key(self, w, e):
        if e.keyval == Gdk.KEY_Escape:
            self.hide()
            return True
        return False

    def show(self):
        self._refill()
        self.win.show_all()
        self.win.present()

    def hide(self):
        self.win.hide()


